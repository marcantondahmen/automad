{
	frankenphp
	auto_https off
}

localhost:80 {
	root * /app

	encode zstd gzip

	# Mirror the blocked files of the .htaccess files. Like in the .htaccess, only existing files are blocked,
	# so that page URLs such as "/blog/data" are still passed on to Automad.
	@denied {
		file
		expression <<CEL
			path_regexp(r'(?i)^/(config|lib)/')
			|| path_regexp(r'(?i)^/automad/(console$|src/|lang/)')
			|| path_regexp(r'(?i)/(data|index)$')
			|| path_regexp(r'(?i)/\.')
			|| path_regexp(r'(?i)/(packages|vendor)/.*\.(ts|less|md|sh|xml|json|lock)$')
			|| path_regexp(r'(?i)/vendor/.*(readme|license)')
			|| path_regexp(r'(?i)/(package|package-lock|composer)\.(json|lock)$')
			CEL
	}

	respond @denied 404

	# Only the front controller is executed.
	@php {
		path *.php
		not path /index.php
	}

	respond @php 404

	php_server
}
